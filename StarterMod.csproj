<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StarterMod</AssemblyName>
    <RootNamespace>StarterMod</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="DiceGame.Unity" HintPath="$(GameManagedDir)/DiceGame.Unity.dll" Private="false" />
    <Reference Include="DiceGame.Combat" HintPath="$(GameManagedDir)/DiceGame.Combat.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(GameManagedDir)/UnityEngine.AssetBundleModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameManagedDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameManagedDir)' == ''" Text="Pass -p:GameManagedDir=&lt;game Data/Managed directory&gt;." />
    <Error Condition="!Exists('$(GameManagedDir)/DiceGame.Unity.dll')" Text="DiceGame.Unity.dll was not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/DiceGame.Combat.dll')" Text="DiceGame.Combat.dll was not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll was not found in $(GameManagedDir)." />
    <Error Condition="!Exists('$(GameManagedDir)/UnityEngine.AssetBundleModule.dll')" Text="UnityEngine.AssetBundleModule.dll was not found in $(GameManagedDir)." />
  </Target>
</Project>
